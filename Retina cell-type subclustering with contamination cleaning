  BC  = list(pattern = "bipolar",    dims = 1:10, max_k = 4),
  HC  = list(pattern = "horizontal", dims = 1:10, max_k = 3),
  RGC = list(pattern = "^RGC",       dims = 1:10, max_k = 4)
)


# ---- 2. First pass: subset, PCA, cluster ------------------------------------
