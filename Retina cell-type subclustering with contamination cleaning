# ---- 1. Helper functions ----------------------------------------------------

# core phototransduction genes: removed from the variable-gene list so the
# cone/rod ambient-RNA program cannot drive the PCs
photo_core <- intersect(c("RHO","GUCA1A","GUCA1B","cngb3.2","cngb3.1","PDE6C","pde6ha.1","gnb3b","rp1l1a","inaa",
                          "FRMPD2","FRMPD2.1","rgs9a","IMPG2","arr3a","PPEF1","rcvrn3","opn1mw1","opn1mw1.1","GNAT2",
                          "PDE6A","PDE6B","rom1b","rom1a","cngb1a","GNAT1","gc2","MYO3A","abca4b","camk1gb",
                          "ENSABLG00000019639"), rownames(obj))

# subset by label pattern, normalise, variable genes (minus photoreceptor genes), scale, PCA
prep_sub <- function(obj, pattern, nfeat = 2000, npcs = 30, drop_genes = photo_core) {
  labs <- grep(pattern, levels(Idents(obj)), ignore.case = TRUE, value = TRUE)
  message("Groups: ", paste(labs, collapse = " | "))
  s <- subset(obj, idents = labs)
  s$orig_label <- as.character(Idents(s))
  message("Cells: ", ncol(s)); print(table(s$orig_label))
  s <- NormalizeData(s, verbose = FALSE)
  s <- FindVariableFeatures(s, selection.method = "vst", nfeatures = nfeat, verbose = FALSE)
  VariableFeatures(s) <- setdiff(VariableFeatures(s), drop_genes)
  s <- ScaleData(s, features = VariableFeatures(s), verbose = FALSE)
  RunPCA(s, features = VariableFeatures(s), npcs = min(npcs, ncol(s) - 1), verbose = FALSE)
}

# cluster at the highest resolution that still gives <= max_k clusters
cluster_sub_k <- function(s, dims, max_k = 5, res_grid = seq(0.05, 1, by = 0.05)) {
  s <- FindNeighbors(s, dims = dims, verbose = FALSE)
  best <- res_grid[1]
  for (r in res_grid) {
    s <- FindClusters(s, resolution = r, verbose = FALSE)
    if (length(unique(s$seurat_clusters)) <= max_k) best <- r else break
  }
  s <- FindClusters(s, resolution = best, verbose = FALSE)
  message("resolution ", best, " -> ", length(unique(s$seurat_clusters)), " clusters")
  print(table(s$seurat_clusters))
  s <- RunUMAP(s, dims = dims, verbose = FALSE)
  s$subcluster <- factor(as.numeric(as.character(s$seurat_clusters)) + 1)   # number from 1
  Idents(s) <- "subcluster"
  s
}

# group definitions: label pattern, PCs used for clustering, maximum number of subclusters
params <- list(
