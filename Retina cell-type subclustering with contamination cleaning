# ---- 3. Contamination scores --------------------------------------------------
contam_sets <- list(
  Muller  = c("rlbp1a", "RHBG", "notch1b"),
  RPE     = c("rpe65a", "tyrp1b"),
  Photo   = c("RHO", "GUCA1A", "cngb3.2", "IMPG2", "elovl8a", "opn1mw1.1", "cnga3a"),
  Oligo   = c("MAG", "MYRF", "UGT8"),
  Cycling = c("mki67", "TOP2A", "ECT2", "FOXN4", "MYBL1", "CCND1")
)
add_contam <- function(s, skip = NULL) {
  for (n in setdiff(names(contam_sets), skip)) {
    g <- intersect(contam_sets[[n]], rownames(s))
    s <- AddModuleScore(s, features = list(g), name = n)       # adds <name>1
  }
  s
}
# Muller glia are skipped for the Muller score (it would be high by identity)
subs <- Map(function(s, n) add_contam(s, skip = if (n == "MGC") "Muller" else NULL), subs, names(subs))

pdf(file.path(out_dir, "03_contamination_violins.pdf"), width = 14, height = 4)
for (n in names(subs)) {
  feats <- intersect(c("Muller1", "RPE1", "Photo1", "Oligo1", "Cycling1"), colnames(subs[[n]]@meta.data))
  print(VlnPlot(subs[[n]], features = feats, pt.size = 0, ncol = 5) + plot_annotation(title = n))
  cat("\n=====", n, "- % cells with score > 0.5, by subcluster =====\n")
  pct <- sapply(feats, function(f) round(100 * tapply(subs[[n]][[f, drop = TRUE]] > 0.5, subs[[n]]$subcluster, mean), 1))
  print(cbind(n_cells = as.vector(table(subs[[n]]$subcluster)), pct))
}
dev.off()


# ---- 4. Filter contaminated cells -------------------------------------------
thr        <- 0.5      # a cell is removed if ANY contamination score exceeds this
bad_cluster_frac <- 0.6  # a whole subcluster is removed if more than this fraction is flagged
score_cols <- c("Muller1", "RPE1", "Photo1", "Oligo1", "Cycling1")

keep_cells <- Map(function(s, n) {
  cols    <- intersect(score_cols, colnames(s@meta.data))
  flagged <- rowSums(s@meta.data[, cols, drop = FALSE] > thr) > 0
  ok      <- !flagged
  frac    <- tapply(flagged, s$subcluster, mean)
  bad     <- names(frac)[frac > bad_cluster_frac]
  if (length(bad)) {
    message(n, ": removing whole subcluster(s) ", paste(bad, collapse = ","), " (> ", 100 * bad_cluster_frac, "% flagged)")
    ok <- ok & !(s$subcluster %in% bad)
  }
  colnames(s)[ok]
}, subs, names(subs))

print(sapply(names(subs), function(n) c(before = ncol(subs[[n]]), after = length(keep_cells[[n]]))))


# ---- 5. Reprocess clean cells and recluster ------------------------------------
subs2 <- Map(function(n, p) prep_sub(subset(obj, cells = keep_cells[[n]]), p$pattern), names(params), params)
names(subs2) <- names(params)

pdf(file.path(out_dir, "04_elbow_clean.pdf"), width = 14, height = 4)
print(wrap_plots(lapply(names(subs2), function(n) ElbowPlot(subs2[[n]], ndims = 30) + ggtitle(n)), nrow = 1))
dev.off()

subs2 <- Map(function(s, p) cluster_sub_k(s, p$dims, p$max_k, res_grid = seq(0.02, 1, by = 0.02)), subs2, params)
pdf(file.path(out_dir, "05_umap_clean.pdf"), width = 12, height = 8)
print(wrap_plots(lapply(names(subs2), function(n) DimPlot(subs2[[n]], label = TRUE) + ggtitle(n)), nrow = 2))
dev.off()

# sanity checks: are any subclusters driven by one sample or by depth?
for (n in names(subs2)) {
