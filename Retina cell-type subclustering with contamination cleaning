get_leg <- function(p) {
  g <- ggplotGrob(p); gb <- g$grobs[grepl("^guide-box", sapply(g$grobs, function(x) x$name))]
  Filter(function(x) !inherits(x, "zeroGrob"), gb)[[1]]
}

# ---------------- 2. one row (a-d + extra bar) for one drawing order ----------------
# draw_order: "default" = object order (like Seurat FeaturePlot) | "top" = grey underneath, expressing cells on top
make_row <- function(gd, ld, gv, lv, draw_order, tg, first_row) {
  co <- Embeddings(cone, "umap")
  e  <- FetchData(cone, c(gd, gv))
  d  <- e[[1]] > 0; v <- e[[2]] > 0
  cls <- factor(ifelse(d & v, "Both", ifelse(d, "Dorsal", ifelse(v, "Ventral", "None"))),
                levels = c("None", "Dorsal", "Ventral", "Both"))
  ttl <- function(prefix, lab) bquote(underline(.(prefix) * " (" * italic(.(lab)) * ")"))
  set.seed(1)

  expr_panel <- function(x, title, letter) {
    mx <- max(x); if (mx == 0) mx <- 1
    o <- if (draw_order == "default") seq_along(x) else order(x > 0, runif(length(x)))
    p <- ggplot(data.frame(u1 = co[o, 1], u2 = co[o, 2], x = x[o]), aes(u1, u2, color = x)) +
      geom_point(size = pt) +
      scale_color_gradient(low = "grey85", high = purple, limits = c(0, mx), guide = "none") +
      labs(tag = letter) + theme_void() + tag_theme +
      theme(plot.title = element_text(hjust = 0.5, size = 12))
    if (first_row) p <- p + ggtitle(title)
    p
  }
  pa <- expr_panel(e[[1]], ttl("Dorsal retina marker", ld), tg[1])
  pb <- expr_panel(e[[2]], ttl("Ventral retina marker", lv), tg[2])

  oc <- if (draw_order == "default") seq_along(cls) else
        order(match(as.character(cls), c("None", "Dorsal", "Ventral", "Both")), runif(length(cls)))
  pc <- ggplot(data.frame(u1 = co[oc, 1], u2 = co[oc, 2], cls = cls[oc]), aes(u1, u2, color = cls)) +
    geom_point(size = pt) + scale_color_manual(values = cols, guide = "none") +
    labs(tag = tg[3]) + theme_void() + tag_theme +
    theme(plot.title = element_text(hjust = 0.5, size = 12))
  if (first_row) pc <- pc + ggtitle(bquote(underline("Cells expressing DV markers")))

  tab_all <- as.data.frame(table(class = cls), responseName = "n")
  bar_one <- function(tab, ylab_txt, letter = NULL) {
    tab$class <- factor(tab$class, levels = c("None", "Both", "Dorsal", "Ventral"))
    tab$pct <- 100 * tab$n / sum(tab$n); tab$g <- "Cones"
    p <- ggplot(tab, aes(g, pct, fill = class)) + geom_col(width = 0.55) +
      scale_fill_manual(values = cols, guide = "none", drop = FALSE) +
      scale_x_discrete(labels = paste0("Cones\n(n = ", format(sum(tab$n), big.mark = ","), ")")) +
      scale_y_continuous(limits = c(0, 100), breaks = seq(0, 100, 10), expand = c(0, 0)) +
      labs(x = NULL, y = ylab_txt) + theme_classic(base_size = 9)
    if (!is.null(letter)) p <- p + labs(tag = letter) + tag_theme
    p
  }
  pd1 <- bar_one(tab_all[tab_all$class != "None", ], "Proportion of expressing cells (%)", tg[4])
  pd2 <- bar_one(tab_all, "Proportion of all cells (%)")

  lab <- if (draw_order == "default") "Default order (object order)" else "Expressing cells on top"
  hdr <- ggplot() + annotate("text", x = 0.5, y = 0.6, label = lab, size = 5) +
    annotate("segment", x = 0, xend = 1, y = 0.08, yend = 0.08, linewidth = 0.3) +
    xlim(0, 1) + ylim(0, 1) + theme_void()
  row <- wrap_plots(pa, pb, pc, pd1, pd2, nrow = 1, widths = c(1, 1, 1, 0.3, 0.3))
  wrap_plots(hdr, row, ncol = 1, heights = c(0.08, 1))
}

# ---------------- 3. figure for one gene pair: default (top row) vs expressing-on-top (bottom row) ----------------
pair_fig <- function(gd, ld, gv, lv, tag) {
  r1 <- make_row(gd, ld, gv, lv, "default", letters[1:4], TRUE)
  r2 <- make_row(gd, ld, gv, lv, "top",     letters[5:8], FALSE)

  leg_expr <- get_leg(ggplot(data.frame(x = c(0, 1), y = 0), aes(x, y, color = x)) + geom_point() +
    scale_color_gradient(low = "grey85", high = purple, name = "Log2 Expr.", breaks = c(0, 1), labels = c("min", "max")) +
    theme(legend.position = "bottom", legend.direction = "horizontal"))
  lab <- as.expression(list(bquote("Dorsal (" * italic(.(ld))^"+" * ")"), bquote("Ventral (" * italic(.(lv))^"+" * ")"),
                            bquote("Both (" * italic(.(ld))^"+" * "/" * italic(.(lv))^"+" * ")"), "None"))
  leg_cls <- get_leg(ggplot(data.frame(x = 1:4, y = 0, c = factor(c("Dorsal", "Ventral", "Both", "None"),
                                                                   levels = c("Dorsal", "Ventral", "Both", "None"))),
                            aes(x, y, color = c)) + geom_point(size = 4) +
    scale_color_manual(values = cols, name = NULL, labels = lab) +
    theme(legend.position = "bottom", legend.direction = "vertical"))
  legs <- wrap_plots(wrap_elements(full = leg_expr), wrap_elements(full = leg_cls), nrow = 1)

  fig <- wrap_plots(r1, r2, legs, ncol = 1, heights = c(1, 1, 0.4))
  f <- file.path(out_dir, paste0("Cones_published_style_orders_", tag))
  ggsave(paste0(f, ".pdf"), fig, width = 13, height = 9)
  ggsave(paste0(f, ".png"), fig, width = 13, height = 9, dpi = 300)
  message("Saved: ", f, ".png")
  invisible(fig)
}

